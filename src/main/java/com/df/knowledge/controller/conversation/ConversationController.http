### 首次发送完整选择，服务端创建会话并流式返回新增消息
POST {{baseUrl}}/knowledge/conversation/send-stream
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: text/event-stream

{
  "question": "知识检索如何工作",
  "afterMessageId": 0,
  "state": {
    "mode": "HYBRID",
    "knowledgeBaseIds": [],
    "formats": [],
    "selectedChunkIds": []
  }
}

### 创建会话
POST {{baseUrl}}/knowledge/conversation/create
Content-Type: application/json
satoken: {{token}}

{
  "title": "如何让知识检索更可信？",
  "knowledgeBaseIds": [1, 2]
}

### 查询当前用户的会话列表
GET {{baseUrl}}/knowledge/conversation/list
satoken: {{token}}

### 恢复会话与消息流
GET {{baseUrl}}/knowledge/conversation/get?id=1
satoken: {{token}}

### 写入用户消息
POST {{baseUrl}}/knowledge/conversation/message/create
Content-Type: application/json
satoken: {{token}}

{
  "conversationId": 1,
  "type": "user",
  "content": {
    "text": "知识检索如何工作",
    "mode": "混合检索",
    "scope": "全部知识库"
  }
}

### 按时间正序读取消息
GET {{baseUrl}}/knowledge/conversation/message/list?conversationId=1
satoken: {{token}}

### 删除会话及其消息
DELETE {{baseUrl}}/knowledge/conversation/delete?id=1
satoken: {{token}}

### 修改会话当前完整选择；只影响后续消息
# 失权的历史选择可继续保留，但每轮读取都重新授权，不扩大访问范围。
PUT {{baseUrl}}/knowledge/conversation/state/update
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id":1,
  "state":{
    "mode":"RAG",
    "knowledgeBaseIds":[1],
    "formats":[1,4],
    "selectedChunkIds":[1,2],
    "modelId":1,
    "guideRound":0,
    "guideAnswers":[]
  }
}
